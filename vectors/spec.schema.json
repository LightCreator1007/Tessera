{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tod/spec/v4",
  "title": "ToD job spec v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workload", "code", "device", "model", "train", "aggregate", "outer", "gate", "data", "replay", "verifiers", "payout", "windows", "refWorkSecondsPerRound"],
  "$defs": {
    "dec": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$|^inf$"},
    "hash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}
  },
  "properties": {
    "version": {"const": 4},
    "workload": {"type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {"id": {"enum": ["mlp-exact/1", "cnn-torch/1", "lora-ffa/1"]}, "baseModel": {"type": ["object", "null"]}}},
    "code": {"type": "object", "additionalProperties": false, "required": ["version", "hash"],
      "properties": {"version": {"type": "string"}, "hash": {"$ref": "#/$defs/hash"}}},
    "device": {"type": "object", "additionalProperties": false, "required": ["class", "threads"],
      "properties": {"class": {"const": "cpu"}, "threads": {"const": 1}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["inputShape", "outputs", "task"],
      "properties": {"inputShape": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1},
        "outputs": {"type": "integer", "minimum": 1}, "hidden": {"type": "integer", "minimum": 1},
        "task": {"enum": ["classification", "regression"]}}},
    "train": {"type": "object", "additionalProperties": false, "required": ["H", "K", "B", "lr", "epochs"],
      "properties": {"H": {"type": "integer", "minimum": 50, "maximum": 500}, "K": {"type": "integer", "minimum": 1},
        "B": {"type": "integer", "minimum": 1}, "lr": {"$ref": "#/$defs/dec"}, "epochs": {"type": "integer", "minimum": 1},
        "innerReset": {"const": true}}},
    "aggregate": {"type": "object", "additionalProperties": false, "required": ["kind", "trim", "clip"],
      "properties": {"kind": {"const": "trimmed-mean"}, "trim": {"const": "0.2"}, "clip": {"const": "median"}}},
    "outer": {"type": "object", "additionalProperties": false, "required": ["kind", "lr", "momentum"],
      "properties": {"kind": {"enum": ["avg", "nesterov"]}, "lr": {"$ref": "#/$defs/dec"}, "momentum": {"$ref": "#/$defs/dec"}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["relTol", "absTol"],
      "properties": {"relTol": {"$ref": "#/$defs/dec"}, "absTol": {"$ref": "#/$defs/dec"}}},
    "data": {"type": "object", "additionalProperties": false, "required": ["datasetHash", "shards", "valFrac", "testFrac"],
      "properties": {"datasetHash": {"$ref": "#/$defs/hash"},
        "shards": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "oneOf": [{"required": ["start", "len"]}, {"required": ["rowsHash", "len"]}],
          "properties": {"start": {"type": "integer", "minimum": 0}, "len": {"type": "integer", "minimum": 1}, "rowsHash": {"$ref": "#/$defs/hash"}}}},
        "valFrac": {"$ref": "#/$defs/dec"}, "testFrac": {"$ref": "#/$defs/dec"}}},
    "replay": {"type": "object", "additionalProperties": false, "required": ["class", "coverage", "tauDrift", "tauFraud"],
      "properties": {"class": {"enum": ["exact", "tolerance"]}, "coverage": {"enum": ["full", "segments"]},
        "tauDrift": {"$ref": "#/$defs/dec"}, "tauFraud": {"$ref": "#/$defs/dec"}}},
    "verifiers": {"const": 2},
    "payout": {"type": "object", "additionalProperties": false, "required": ["mode", "floorBps"],
      "properties": {"mode": {"const": "equal"}, "floorBps": {"type": "integer", "minimum": 0, "maximum": 10000}}},
    "windows": {"type": "object", "additionalProperties": false, "required": ["commit", "reveal", "verify", "finalize", "stall"],
      "properties": {"commit": {"type": "integer", "minimum": 1}, "reveal": {"type": "integer", "minimum": 1},
        "verify": {"type": "integer", "minimum": 1}, "finalize": {"type": "integer", "minimum": 1}, "stall": {"type": "integer", "minimum": 1}}},
    "refWorkSecondsPerRound": {"type": "integer", "minimum": 0},
    "sandbox": {"type": "null"}, "val": {"type": "null"}, "detector": {"type": "null"}
  }
}
