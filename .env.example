# Copy to .env (gitignored) and fill in. Testnet values only, never commit .env.

# Chain
BASE_SEPOLIA_RPC_URL=          # Alchemy Base Sepolia URL with your key: https://base-sepolia.g.alchemy.com/v2/<key>

# Keys (hex private keys, testnet only)
DEPLOYER_PRIVATE_KEY=
COORDINATOR_PRIVATE_KEY=
ADMITTER_PRIVATE_KEY=          # signs pool invites after an identity check
VERIFIER_A_PRIVATE_KEY=
VERIFIER_B_PRIVATE_KEY=
FAUCET_PRIVATE_KEY=            # tops up operator gas

# Coordinator chain settings; contract addresses also live in networks/*.toml
CHAIN_ID=31337                 # 84532 for Base Sepolia
JOB_MARKET=
NODE_REGISTRY=
TOKEN=                         # test token; MockUSDC only on local Anvil
VERIFIERS=                     # comma-separated verifier addresses

# Identity (services/coordinator/identity)
IDENTITY_MODE=dev              # dev skips World ID and is refused unless CHAIN_ID is 31337; worldid uses real World ID
WORLD_ID_APP_ID=               # app_... from developer.world.org (not secret)
WORLD_ID_RP_ID=                # rp_... from developer.world.org (not secret)
WORLD_ID_RP_SIGNING_KEY=       # SECRET, shown once by the portal. Server only
WORLD_ID_ACTION=tod-pool-join
WORLD_ID_ENV=staging           # staging uses the World ID simulator

# World ID Agent Pass (OIDC); the owner approves before an agent pairs a node
WORLD_AUTH_ISSUER=https://sandbox.auth.world.org   # https://auth.world.org in production
WORLD_AUTH_CLIENT_ID=
WORLD_AUTH_CLIENT_SECRET=      # SECRET, shown once by the portal

# Operator gas top-up (POST /v1/identity/topup), paid from FAUCET_PRIVATE_KEY on TOD_NETWORK
TOPUP_TARGET_WEI=1000000000000000   # 0.001 ETH; sent only when the operator holds under half of it
TOPUP_CAP_WEI=5000000000000000      # lifetime allowance per World ID human, across all their operators
TOPUP_COOLDOWN_SECONDS=3600

# Node
TOD_NETWORK=                   # anvil or base-sepolia; overrides `tod-node init --network`, and is the chain the top-up pays on
TOD_COORDINATOR=               # coordinator base URL, e.g. http://127.0.0.1:8000; overrides `init --coordinator`
