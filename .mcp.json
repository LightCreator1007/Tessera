{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@colbymchenry/codegraph@1.6.2", "serve", "--mcp"],
      "env": {
        "CODEGRAPH_TELEMETRY": "0",
        "DO_NOT_TRACK": "1"
      }
    },
    "openzeppelin": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@openzeppelin/contracts-mcp@0.8.1"]
    }
  }
}
