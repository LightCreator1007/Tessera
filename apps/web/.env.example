# Coordinator base URL. Unset = demo fixtures with a visible "Demo data" label.
NEXT_PUBLIC_COORDINATOR_URL=

# Local node bridge. On by default so a console on the node's laptop can read it; set to off on a hosted deploy.
TOD_NODE_BRIDGE=
# Where the bridge finds the node. Defaults: http://127.0.0.1:7777 and the tod-node wrapper on PATH.
TOD_NODE_API=
TOD_NODE_CLI=
# Where a hosted page finds the visitor's node from their browser. Default http://127.0.0.1:7777. The node must be
# started with this site in TOD_WEB_ORIGINS, or it refuses the page.
NEXT_PUBLIC_NODE_API=

# Dev only: Agentation collector (agentation-mcp server), e.g. http://localhost:4747. Leave empty to copy feedback to the clipboard instead.
NEXT_PUBLIC_AGENTATION_ENDPOINT=
